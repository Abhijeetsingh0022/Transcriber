# TMUX AI Gateway Multi-Tier Provider Configuration
# Tier 1 (Primary): Google Gemini 3.8 Flash
GEMINI_API_KEY=your_gemini_api_key_here

# Tier 2 (Secondary Fallback): OpenRouter Free Models
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional model override (defaults to liquid/lfm-2.5-2.6b:free -> nvidia/nemotron-3.5-lightning:free):
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Tier 3 (Tertiary Fallback): Token Harbor Free Models (60 RPM / 1800 RPH shared cap)
TOKENHARBOR_API_KEY=your_tokenharbor_api_key_here
# Optional model override (defaults to deepseek-v4.1-flash:free -> claude-haiku-5.5:free -> mimo-v2.6-flash:free):
# TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
